{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval",
  "description": "An immutable, signed, mergeable record. Promotion = a valid approval exists.",
  "type": "object",
  "properties": {
    "approver": {
      "$ref": "#/$defs/Principal"
    },
    "challenge": {
      "anyOf": [
        {
          "$ref": "#/$defs/Challenge"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "#/$defs/ApprovalKind"
    },
    "signature_hex": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_hash": {
      "type": "string"
    }
  },
  "required": [
    "subject_hash",
    "kind",
    "approver"
  ],
  "$defs": {
    "ApprovalKind": {
      "type": "string",
      "enum": [
        "test",
        "audit",
        "human"
      ]
    },
    "Challenge": {
      "type": "object",
      "properties": {
        "action_digest": {
          "type": "string"
        },
        "expires_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "nonce": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "resource",
        "action_digest",
        "nonce",
        "expires_at_ms"
      ]
    },
    "Principal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "machine"
            },
            "lease_id": {
              "type": "string"
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "node_id",
            "lease_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "human"
            }
          },
          "required": [
            "kind",
            "device_id"
          ]
        }
      ]
    }
  }
}
