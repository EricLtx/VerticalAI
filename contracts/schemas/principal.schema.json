{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Principal",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "machine"
        },
        "lease_id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id",
        "lease_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "human"
        }
      },
      "required": [
        "kind",
        "device_id"
      ]
    }
  ]
}
