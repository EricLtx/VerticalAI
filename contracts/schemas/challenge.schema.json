{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Challenge",
  "type": "object",
  "properties": {
    "action_digest": {
      "type": "string"
    },
    "expires_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "nonce": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    }
  },
  "required": [
    "resource",
    "action_digest",
    "nonce",
    "expires_at_ms"
  ]
}
